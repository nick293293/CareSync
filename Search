  import React,{ useState } from "react";
  import { Box, Heading, Text, Button, Flex, Stack, Input } from "@chakra-ui/react";
  import { useNavigate } from "react-router-dom";
  import { jsPDF } from "jspdf"; // Import jsPDF for generating PDFs
    
  const StaffPage = () => {
  const navigate = useNavigate();
  const [searchTerm, setSearchTerm] = useState("");
  const [patients, setPatients] = useState([]);
  const [error, setError] = useState("");
  const [loading, setLoading] = useState(false);
  const [reportLoading, setReportLoading] = useState(false); // New: Loading state for report

    //handles logout
    const handleLogout = () => {
      navigate("/"); // Navigates to the staff login page
    };

      //Function to search for patients 
        const handleSearch = async () => {
    if (!searchTerm) {
      setError("Please enter a patient ID or name.");
      return;
    }
    setError("");
    setLoading(true); //Show loading state while searching
          

    try {
      const response = await fetch(`/api/patient?searchTerm=${encodeURIComponent(searchTerm)}`);
      const data = await response.json();

      if (response.ok) {
        setPatients(data);
      } else {
        setError(data.message || "Error fetching patient data.");
        setPatients([]);
      }
    } catch (err) {
      setError("Network error. Please try again.");
    } finally {
      setLoading(false);  //Ensures loading state is reset
    }
  };
    
   // Function to generate and download patient report as PDF
  const generateReport = async () => {
    setReportLoading(true);
    try {
      const response = await fetch("/api/reports/patients");
      const data = await response.json();

      if (response.ok) {
        const doc = new jsPDF();
        doc.text("Patient Report", 10, 10);

        data.forEach((patient, index) => {
          doc.text(
            `ID: ${patient.patient_id}, Name: ${patient.name}, DOB: ${patient.dob}`,
            10,
            20 + index * 10
          );
        });

        doc.save("patient_report.pdf");
      } else {
        alert("Error generating report.");
      }
    } catch (error) {
      alert("Network error. Could not generate report.");
    } finally {
      setReportLoading(false);
    }
  };
    return (
      <Flex
        align="center"
        justify="center"
        bg="gray.50"
        minHeight="100vh"
        width="100vw"
        overflow="hidden"
      >
        <Box
          bg="white"
          p={{ base: 6, md: 12 }}
          borderRadius="md"
          shadow="lg"
          width="100%"
          maxWidth="800px"
          mx="auto"
          position="relative"
        >
          {/* Top-Right Buttons */}
          <Box position="absolute" top={4} right={4} display="flex" gap={4}>
            <Button
              colorScheme="teal"
              size="sm"
              onClick={() => alert("View Notifications")}
            >
              Notifications
            </Button>
            <Button
              colorScheme="teal"
              size="sm"
              onClick={() => alert("Open Settings")}
            >
              Settings
            </Button>
            <Button
              colorScheme="red"
              size="sm"
              onClick={handleLogout} // logout function
            >
              Logout
            </Button>
          </Box>
  
          {/* Staff Home Heading */}
          <Heading as="h1" size="xl" mb={4} textAlign="center" color="gray.700">
            Staff Home
          </Heading>
  
          {/* Welcome Message */}
          <Text textAlign="center" mb={6} color="gray.600" fontSize="lg">
            Welcome, Doctor! Here's an overview of your tasks.
          </Text>
  
          <Stack spacing={6}>
            {/* Today's Appointments Widget */}
            <Box
              bg="gray.100"
              p={6}
              borderRadius="md"
              shadow="sm"
              textAlign="center"
            >
              <Heading as="h3" size="md" mb={2} color="gray.700">
                Today's Appointments
              </Heading>
              <Text color="gray.600">15 Appointments Scheduled</Text>
              <Button
                mt={4}
                colorScheme="teal"
                size="sm"
                onClick={() => alert("View Appointments")}
              >
                View Details
              </Button>
            </Box>
  
   {/* Look Up Patient Widget with Search */}
            <Box bg="gray.100" p={6} borderRadius="md" shadow="sm" textAlign="center">
              <Heading as="h3" size="md" mb={2} color="gray.700">
                Look Up Patient
              </Heading>
              <Text color="gray.600">Find patient information quickly.</Text>
              <Input 
                mt={4} 
                placeholder="Enter Patient ID or Name" 
                value={searchTerm} 
                onChange={(e) => setSearchTerm(e.target.value)} 
              />
              <Button mt={4} colorScheme="teal" size="sm" onClick={handleSearch}>
                Search
              </Button>
              
                {/* Show loading indicator when searching */}
            {loading && <Text mt={2} color="gray.600">Searching... <Spinner size="sm" /></Text>}
            {error && <Text color="red.500" mt={2}>{error}</Text>}
              {/* Display Search Results */}
              {error && <Text color="red.500" mt={2}>{error}</Text>}
              {patients.length > 0 && (
                <Box mt={4} p={4} bg="white" borderRadius="md" shadow="sm">
                  <Heading as="h4" size="md" color="gray.700" mb={2}>Search Results</Heading>
                  <Stack spacing={3}>
                    {patients.map((patient) => (
                      <Box key={patient.patient_id} p={3} bg="gray.50" borderRadius="md">
                        <Text><strong>Name:</strong> {patient.name}</Text>
                        <Text><strong>DOB:</strong> {patient.dob}</Text>
                        <Text><strong>Address:</strong> {patient.address}</Text>
                        <Text><strong>Phone:</strong> {patient.phone_number}</Text>
                        <Text><strong>Email:</strong> {patient.email}</Text>
                      </Box>
                    ))}
                  </Stack>
                </Box>
              )}
            </Box>
     {/* Generate Report Button */}
          <Box bg="gray.100" p={6} borderRadius="md" shadow="sm" textAlign="center">
            <Heading as="h3" size="md" mb={2} color="gray.700">
              Generate Patient Report
            </Heading>
            <Text color="gray.600">Download a complete patient report.</Text>
            <Button mt={4} colorScheme="blue" size="sm" onClick={generateReport} isLoading={reportLoading}>
              Generate PDF Report
            </Button>
          </Box>
            
          {/* Manage Appointments Widget */}
            <Box
              bg="gray.100"
              p={6}
              borderRadius="md"
              shadow="sm"
              textAlign="center"
            >
              <Heading as="h3" size="md" mb={2} color="gray.700">
                Manage Appointments
              </Heading>
              <Text color="gray.600">View and organize all appointments.</Text>
              <Button
                mt={4}
                colorScheme="teal"
                size="sm"
                onClick={() => alert("Manage Appointments")}
              >
                Manage Appointments
              </Button>
            </Box>
          </Stack>
        </Box>
      </Flex>
    );
  };
  
  export default StaffPage;
